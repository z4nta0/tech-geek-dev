{
	"name": "tech-geek-dev",
	"private": true,
	"version": "1.10.0",
	"type": "module",
	"scripts": {
		"build": "tsc -b && vite build",
		"dev": "vite",
		"images": "node design/images/render.mts",
		"lint": "eslint .",
		"preview": "vite preview",
		"test": "playwright test --config tests/playwright.config.ts",
		"test:accessibility": "playwright test --config tests/playwright.config.ts --project \"accessibility-*\"",
		"test:rendering": "playwright test --config tests/playwright.config.ts --project \"rendering-*\"",
		"test:responsive": "playwright test --config tests/playwright.config.ts --project \"responsive-*\"",
		"typecheck": "tsc -b"
	},
	"dependencies": {
		"@netlify/functions": "^5.1.5",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-router": "^8.4.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@playwright/test": "^1.64.0",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"eslint": "^9.39.5",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"jiti": "^2.7.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4"
	}
}
